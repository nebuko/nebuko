{# Caller workflow generated by `nebuko init` (issue #1025).

   The rendered first line is the idempotence marker: `CallerWorkflowWriter`
   uses it to decide CREATED/UNCHANGED/UPDATED/REFUSED.
   GitHub expressions are wrapped in `{% raw %}` so Jinja leaves them intact.
#}
# generated by nebuko init
# Re-running `nebuko init` updates this file in place; a workflow this command
# did not generate is never overwritten.
#
# The reusable workflow below mints its GitHub token from the OIDC broker at
# {% raw %}${{ vars.{% endraw %}{{ broker_variable }}{% raw %} }}{% endraw %}, so the repository variable must stay set.
name: Nebuko

# `!!str` keeps the key a string: YAML 1.1 parsers (PyYAML) would otherwise read
# an unquoted `on` as the boolean true. GitHub reads it as the `on` key either way.
!!str on:
  issue_comment:
    types: [created, edited]

permissions:
  contents: write
  pull-requests: write
  issues: write
  id-token: write
  actions: write

jobs:
  agent:
    if: >-
      contains(fromJSON('["OWNER","MEMBER","COLLABORATOR"]'),
               github.event.comment.author_association) ||
      github.event.comment.user.login == 'nebuko[bot]'
    uses: nebuko/nebuko/.github/workflows/nebuko-workflow.yaml@main
    with:
      agent_config_path: ".nebuko/agents/agent-config.yaml"
    secrets:
      GH_PAT: {% raw %}${{ secrets.GH_PAT }}{% endraw %}

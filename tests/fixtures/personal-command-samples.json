{
  "_provenance": "Shared --personal classification samples (issue #1479). Mirror of the broker table (nebuko/token-broker PR 60): re-sync whenever that table changes. The rule is first-line-only, matching CommandSource.from_body: the first line of the comment, stripped, is parsed as a /nebuko command, and a terminal --feedback value swallows the rest of that line. class is 'personal dispatch' (the project side skips it) or 'project run'. condition is the caller workflow verdict: start-run means the caller starts a run; start-noop means the caller may start a runner that the engine skips, or skip it outright for the exact one-flag shapes. A project run row must never be skipped by the caller (tests/engine/init/test_caller_personal_guard.py).",
  "samples": [
    {"name": "run with lane flag on the first line", "body": "/nebuko run workflow --name default --personal", "class": "personal dispatch", "condition": "start-noop"},
    {"name": "approve gate on personal lane", "body": "/nebuko approve gate --personal", "class": "personal dispatch", "condition": "start-noop"},
    {"name": "reject gate with the flag before feedback", "body": "/nebuko reject gate --personal --feedback no", "class": "personal dispatch", "condition": "start-noop"},
    {"name": "resume on personal lane", "body": "/nebuko resume --personal", "class": "personal dispatch", "condition": "start-noop"},
    {"name": "indented first line", "body": "    /nebuko approve gate --personal", "class": "personal dispatch", "condition": "start-noop"},
    {"name": "CRLF line endings after the first line", "body": "/nebuko approve gate --personal\r\nthanks", "class": "personal dispatch", "condition": "start-noop"},
    {"name": "run with lane flag, CRLF and more text", "body": "/nebuko run workflow --name default --personal\r\nplease start", "class": "personal dispatch", "condition": "start-noop"},
    {"name": "command on a later line after a prose first line", "body": "thanks\n/nebuko approve gate --personal", "class": "project run", "condition": "start-run"},
    {"name": "run with project lane flag", "body": "/nebuko run workflow --name default --project", "class": "project run", "condition": "start-run"},
    {"name": "approve gate on project lane", "body": "/nebuko approve gate --project", "class": "project run", "condition": "start-run"},
    {"name": "flag in prose", "body": "run this with /nebuko run workflow --personal please", "class": "project run", "condition": "start-run"},
    {"name": "flag with an attached value", "body": "/nebuko run workflow --personal=x", "class": "project run", "condition": "start-run"},
    {"name": "flag with a separate value", "body": "/nebuko run workflow --personal yes", "class": "project run", "condition": "start-run"},
    {"name": "flag before the command", "body": "--personal /nebuko run workflow", "class": "project run", "condition": "start-run"},
    {"name": "hyphenated command name", "body": "/nebuko-foo --personal", "class": "project run", "condition": "start-run"},
    {"name": "command inside a closed fence", "body": "```\n/nebuko approve gate --personal\n```", "class": "project run", "condition": "start-run"},
    {"name": "fence opened on the first line", "body": "```\n/nebuko approve gate --personal", "class": "project run", "condition": "start-run"},
    {"name": "quoted command", "body": "> /nebuko approve gate --personal", "class": "project run", "condition": "start-run"},
    {"name": "flag on a non-command line", "body": "approve --personal", "class": "project run", "condition": "start-run"},
    {"name": "flag after the feedback text", "body": "/nebuko reject gate --feedback no --personal", "class": "project run", "condition": "start-run"},
    {"name": "gate command without the flag, personal command on a later line", "body": "/nebuko approve gate\n/nebuko approve gate --personal", "class": "project run", "condition": "start-run"},
    {"name": "both lane flags on one run", "body": "/nebuko run workflow --name default --personal --project", "class": "project run", "condition": "start-run"},
    {"name": "personal flag with an unknown flag", "body": "/nebuko approve gate --personal --bogus", "class": "project run", "condition": "start-run"},
    {"name": "personal flag repeated", "body": "/nebuko resume --personal --personal", "class": "project run", "condition": "start-run"}
  ]
}

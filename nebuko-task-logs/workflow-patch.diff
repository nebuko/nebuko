@@ -0,0 +1,43 @@
+name: internal-deploy-sites
+
+# Builds the per-site deploy outputs from the maintenance flags and uploads them
+# to the Cloudflare Pages projects. Toggling maintenance = flip the value in
+# `maintenance.yaml`, push, and this pipeline materializes the new state.
+#
+# `site` and `blog` deploy from the generator outputs; `docs` keeps the project
+# documentation (only `index.html`/`logo.svg` are overwritten by the generator).
+#
+# Required repository secrets: CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID.
+# The project names must match the Cloudflare Pages projects for each site.
+on:
+  push:
+    branches: [main]
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  deploy:
+    runs-on: ubuntu-latest
+    strategy:
+      matrix:
+        include:
+          - site: site
+            project: nebuko-site
+          - site: docs
+            project: nebuko-docs
+          - site: blog
+            project: nebuko-blog
+    steps:
+      - uses: actions/checkout@v5
+
+      - name: Build the site outputs
+        run: uv run python scripts/build_sites.py
+
+      - name: Upload to Cloudflare Pages
+        uses: cloudflare/wrangler-action@v3
+        with:
+          apiToken: ${{ secrets.CLOUDFLARE_API_TOKEN }}
+          accountId: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
+          command: pages deploy "${{ matrix.site }}" --project-name "${{ matrix.project }}"

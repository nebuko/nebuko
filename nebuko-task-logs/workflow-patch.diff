diff --git a/.github/workflows/nebuko-workflow.yaml b/.github/workflows/nebuko-workflow.yaml
index f12f3c6..4ebfc39 100644
--- a/.github/workflows/nebuko-workflow.yaml
+++ b/.github/workflows/nebuko-workflow.yaml
@@ -274,6 +274,8 @@ jobs:
                 ACTOR_LOGIN: ${{ github.event.comment.user.login || github.event.issue.user.login || github.actor || '' }}
                 ACTOR_TYPE: ${{ github.event.comment.user.type || github.event.issue.user.type || '' }}
                 CLAUDE_CODE_OAUTH_TOKEN_SECRET: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
+                TRUSTED_BOTS: ${{ inputs.TRUSTED_BOTS || '["nebuko[bot]"]' }}
+                TRIGGER_COMMENT_HEADER: ${{ github.event.comment.body }}
               run: |
                 # Guard 1 + 2: per-user runners hold the Claude Code token in
                 # their own environment; a shared secret or a nebuko-* label
@@ -287,13 +289,42 @@ jobs:
                     nebuko-*) echo "::error::runner_strategy=per-user computes nebuko-<user> labels; a static runs_on starting with nebuko- ('$RUNS_ON') is not allowed"; exit 1 ;;
                   esac
                 fi
-                # Guard 3: bot, schedule and actor-less runs have no user whose
-                # subscription should pay for the claude-code backend.
+                # Guard 3: schedule and actor-less runs have no user whose
+                # subscription should pay for the claude-code backend. A bot
+                # actor is refused unless it is a trusted bot continuing a
+                # comment that carries a continuation marker in its header; the
+                # engine then checks the human-started state behind it (ADR 0017).
+                API_LANE="Use the API-key lane instead: a provider API key secret with a non-claude-code backend in the agent config."
                 if [ -n "$CLAUDE_CODE_OAUTH_TOKEN_SECRET" ]; then
-                  if [ "$EVENT_NAME" = "schedule" ] || [ -z "$ACTOR_LOGIN" ] || [ "$ACTOR_TYPE" = "Bot" ] || [[ "$ACTOR_LOGIN" == *"[bot]" ]]; then
-                    echo "::error::The claude-code backend cannot run for bot, schedule or actor-less events ($EVENT_NAME, actor '${ACTOR_LOGIN:-none}'). Use the API-key lane instead: a provider API key secret with a non-claude-code backend in the agent config."
+                  if [ "$EVENT_NAME" = "schedule" ] || [ -z "$ACTOR_LOGIN" ]; then
+                    echo "::error::The claude-code backend cannot run for schedule or actor-less events ($EVENT_NAME, actor '${ACTOR_LOGIN:-none}'). $API_LANE"
                     exit 1
                   fi
+                  if [ "$ACTOR_TYPE" = "Bot" ] || [[ "$ACTOR_LOGIN" == *"[bot]" ]]; then
+                    if [ "$EVENT_NAME" != "issue_comment" ]; then
+                      echo "::error::Bot actor '$ACTOR_LOGIN' on $EVENT_NAME cannot start a claude-code run. $API_LANE"
+                      exit 1
+                    fi
+                    if ! jq -e --arg a "$ACTOR_LOGIN" 'index($a) != null' <<<"$TRUSTED_BOTS" >/dev/null 2>&1; then
+                      echo "::error::Rule 'trusted-bot' failed: bot '$ACTOR_LOGIN' is not in TRUSTED_BOTS. $API_LANE"
+                      exit 1
+                    fi
+                    HEADER=$(printf '%s\n' "$TRIGGER_COMMENT_HEADER" | head -n 2)
+                    if ! grep -Fq -e '<!-- workflow-continue -->' -e '<!-- bot-trigger:' <<<"$HEADER"; then
+                      echo "::error::Rule 'continuation-marker' failed: bot comment '$ACTOR_LOGIN' has no continuation marker in its first two lines, so it is a fresh bot-initiated run. $API_LANE"
+                      exit 1
+                    fi
+                    # The header is handed to the engine, which checks the
+                    # human-started WORKFLOW_STATE behind this continuation.
+                    if [ -n "${GITHUB_ENV:-}" ]; then
+                      {
+                        echo "TRIGGER_COMMENT_HEADER<<NEBUKO_HEADER_EOF"
+                        printf '%s\n' "$HEADER"
+                        echo "NEBUKO_HEADER_EOF"
+                        echo "TRUSTED_BOTS=$TRUSTED_BOTS"
+                      } >> "$GITHUB_ENV"
+                    fi
+                  fi
                 fi
 

# Issue #1240 — cut the remaining ~18 s of per-run setup:
#  - pin the uv version so setup-uv skips the astral versions ndjson fetch (~2 s)
#  - suppress the OpenHands SDK banner in the run-task job env
#  - run secret_env as a direct script instead of `-m nebuko.engine.lib`:
#    the module is stdlib-only and self-contained, but `python -m` first
#    imports the `nebuko.engine` package whose __init__ pulls the OpenHands
#    SDK (~5 s). Direct-file execution keeps the same output and $GITHUB_ENV
#    delivery while making the step ~1 s.
# Data-only patch, applied in memory by WorkflowSpec.load() (positional).
--- a/.github/workflows/nebuko-workflow.yaml
+++ b/.github/workflows/nebuko-workflow.yaml
@@ -237,2 +238,3 @@
             AGENT_CONFIG_PATH: ${{ inputs.agent_config_path || 'agent-config.yaml' }}
+            OPENHANDS_SUPPRESS_BANNER: "1"
@@ -337,1 +340,2 @@
                   with:
+                  version: "0.13.6"
@@ -371,1 +374,1 @@
-              run: uv run --no-sync --project "$NEBUKO_ROOT" python -m nebuko.engine.lib.secret_env
+              run: uv run --no-sync --project "$NEBUKO_ROOT" python "$NEBUKO_ROOT/src/nebuko/engine/lib/secret_env.py"

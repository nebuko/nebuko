vars: {
  d2-config: {
    theme-id: 0
    dark-theme-id: 200
    pad: 40
    center: true
  }
}

# ---------- Reusable connection styles ----------
classes: {
  call: {
    style: {
      stroke: "#2563eb"
      stroke-width: 2
      animated: true
    }
  }
  reply: {
    style: {
      stroke: "#16a34a"
      stroke-width: 2
      stroke-dash: 4
      animated: true
    }
  }
  human: {
    style: {
      stroke: "#7c3aed"
      stroke-width: 3
      animated: true
    }
  }
  gate: {
    style: {
      stroke: "#f59e0b"
      stroke-width: 3
      animated: true
    }
  }
  reject: {
    style: {
      stroke: "#dc2626"
      stroke-width: 2
      stroke-dash: 6
      animated: true
    }
  }
}

shape: sequence_diagram

# ---------- Participants ----------
H: "👤 Human" {
  shape: person
  style: {
    fill: "#ede9fe"
    stroke: "#7c3aed"
    stroke-width: 2
    font-size: 18
    bold: true
  }
}
I: "💬 Issue Thread\n(State Carrier)" {
  style: {
    fill: "#e0f2fe"
    stroke: "#0284c7"
    stroke-width: 2
    border-radius: 10
    shadow: true
    font-size: 16
    bold: true
  }
}
E: "⚙️ Nebuko Engine\n(Stateless)" {
  style: {
    fill: "#fef3c7"
    stroke: "#d97706"
    stroke-width: 2
    border-radius: 10
    shadow: true
    font-size: 16
    bold: true
  }
}
A: "📐 Architect" {
  style: {
    fill: "#dbeafe"
    stroke: "#2563eb"
    stroke-width: 2
    border-radius: 10
    shadow: true
    font-size: 16
    bold: true
  }
}
C: "🔍 Context" {
  style: {
    fill: "#dcfce7"
    stroke: "#16a34a"
    stroke-width: 2
    border-radius: 10
    shadow: true
    font-size: 16
    bold: true
  }
}
D: "💻 Dev" {
  style: {
    fill: "#fce7f3"
    stroke: "#db2777"
    stroke-width: 2
    border-radius: 10
    shadow: true
    font-size: 16
    bold: true
  }
}
R: "👀 Review" {
  style: {
    fill: "#ffedd5"
    stroke: "#ea580c"
    stroke-width: 2
    border-radius: 10
    shadow: true
    font-size: 16
    bold: true
  }
}

# ---------- Trigger ----------
H -> I: "/nebuko run workflow" {class: human}
I -> E: "GitHub Actions trigger (on: issue_comment)" {class: call}

# ---------- Phase 1 ----------
phase1: "Phase 1 — Planning & Context" {
  style: {
    fill: "#eff6ff"
    stroke: "#93c5fd"
    stroke-width: 2
    border-radius: 12
    font-size: 16
    bold: true
  }

  E -> I: "Read latest WORKFLOW_STATE" {class: call}
  E -> A: "Dispatch: analyze" {class: call}
  A -> I: "Triage + delegation to context" {class: reply}
  E -> C: "Dispatch: context" {class: call}
  C -> I: "Report: relevant files, code, web search" {class: reply}
  E -> A: "Dispatch: plan" {class: call}
  A -> I: "Architecture proposal (ODA) — state: hold, pin = true" {class: reply}
}

# ---------- Human gate ----------
gate: "🛑 Human gate" {
  style: {
    fill: "#fffbeb"
    stroke: "#f59e0b"
    stroke-width: 3
    stroke-dash: 3
    border-radius: 12
    font-size: 16
    bold: true
  }

  I."🛑 gate = dispatch.status: hold in state, not UI"
  H -> I: "/nebuko approve gate [--feedback \"...\"]" {class: gate}
  I -> E: "Trigger on comment" {class: call}
  E -> I: "Re-read state" {class: call}
}

# ---------- Approved ----------
approved: "alt: approved (feedback injected into next prompt)" {
  style: {
    fill: "#f0fdf4"
    stroke: "#86efac"
    stroke-width: 2
    border-radius: 12
    font-size: 16
    bold: true
  }

  E."Phase 2 — Execution & Review"
  E -> D: "Dispatch: implement" {class: call}
  D -> I: "Diff summary + PR opened + updated state" {class: reply}
  E -> R: "Dispatch: review (different model, adversarial)" {class: call}
  R -> I: "Verdict + final state" {class: reply}
}

# ---------- Rejected ----------
rejected: "else: rejected" {
  style: {
    fill: "#fef2f2"
    stroke: "#fca5a5"
    stroke-width: 2
    border-radius: 12
    font-size: 16
    bold: true
  }

  E -> A: "Re-dispatch: plan — revise ODA with feedback (loops to gate)" {class: reject}
}

# ---------- Footer ----------
E."each cycle = a fresh Actions run re-reading the thread"
R."each cycle = a fresh Actions run re-reading the thread"
H -> H: "Reviews PR, merges" {class: human}
